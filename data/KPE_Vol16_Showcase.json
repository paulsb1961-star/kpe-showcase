      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Changgyeonggung Palace."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "창경궁을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Light & Shadow"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Sunlight falls across an old palace, and shadows answer."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Brightness and darkness, laughter and silence, the present and history share a single frame."
        },
        {
          "lang": "en",
          "head": false,
          "text": "“Now, yet not now; then, yet not then.”"
        },
        {
          "lang": "en",
          "head": false,
          "text": "In layered time, personal memory meets the memory of place."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Here, even shadow is as essential as light."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "빛과 그림자"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "궁궐 위로 햇살이 내리고, 그림자가 응답합니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "밝음과 어둠, 웃음과 침묵, 현재와 역사가 한 장면 안에 겹쳐집니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "“지금이면서 지금이 아니고, 그때이면서도 그때가 아닌.”"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "겹쳐진 시간 속에서 개인의 기억과 공간의 기억이 만납니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이곳에서는 그림자 또한 햇살만큼 중요합니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Hidden stories converge as shadows within a single frame."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "봄 햇살 아래, 이야기가 그림자로 모인다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Fallen spring petals scattered across the surface of a pond"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "연못 수면에 흩어진 봄 꽃잎"
        }
      ]
    },
