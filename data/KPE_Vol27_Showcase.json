      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set at Daeseomun Gate."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대서문을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Autumn Flow"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Autumn colors drape Bukhansan slopes."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Sunset stains fortress walls."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Three hundred years ago, a king walked here."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Today, we walk again."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Leaves, stone, sunlight, return."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Time speaks softly."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "가을 흐름"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "북한산 자락을 물들이는 오색 단풍."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "석양의 붉은 빛이 성벽에 스며듭니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "300년 전 왕의 발걸음을 오늘 우리가 다시 밟습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "단풍, 바위, 햇살, 귀가."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "홍산 작가의 렌즈가 시간의 언어로 말을 건넵니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Today, we walk the very paths once trodden by kings."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "왕이 걷던 길 위에서 오늘을 걷는다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Autumn foliage among mossy rocks and scattered fallen leaves"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이끼 낀 바위와 흩어진 낙엽 사이 가을 단풍"
        }
