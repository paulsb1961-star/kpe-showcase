      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set at Geumseonsa Temple."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "금선사를 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Upward Path"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Water flows downward, people climb upward."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Six hundred years of loss and rebuild, yet stone and water remain."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Valley, stone, people, sky—a journey from outer world to inner self."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "오르는 길"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "물은 아래로 흐르고, 사람은 위로 오릅니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "육백 년의 역사 속 계곡과 바위는 여전히 남습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "계곡, 바위, 사람, 하늘."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "외부에서 내면으로, 욕망에서 자유로 향하는 여정."
        },
        {
          "lang": "en",
          "head": false,
          "text": "As water flows downward, quiet freedom rises within."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "물은 흐르고 자유는 깨어난다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A single pine seen through the temple gate"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "절 문 너머로 보이는 소나무 한 그루"
        }
      ]
