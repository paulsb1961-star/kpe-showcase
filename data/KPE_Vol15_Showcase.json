      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Samcheonsa Temple."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "삼천사를 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Flowing Form"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Along a mountain path, sound drifts with wind."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Before the ancient rock-carved Buddha, prayers gather and rise like water."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Even stone, thought unmoving, flows with time."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Path, stream, Buddha, temple."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Light enters slowly, and everything—seen or unseen—continues to flow."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "흐르는 소리"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산길을 따라 풍경 소리가 흐릅니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "천년 마애불 앞에서 기도가 스며들고, 석양의 빛이 절집을 적십니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "변하지 않는 듯한 돌도 시간 속에서 천천히 흐르고 있습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산길, 계곡, 마애불, 절집."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "보이는 것과 보이지 않는 것 모두 흐름 속에 있습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Impermanence is not sorrow, but the quiet beauty of life."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "풍경 소리가 바람 따라 흐른다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A large granite boulder rising above a temple roof against a blue sky"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "파란 하늘, 절집 지붕 위로 솟은 큰 화강암 바위"
        }
      ]
    },
