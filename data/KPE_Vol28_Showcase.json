      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Gijachon Village."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "기자촌을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Returning Time"
        },
        {
          "lang": "en",
          "head": false,
          "text": "In a redeveloping village, sunlight, seasons, shadow, and light—memory persists."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Ginkgo trees, pine groves, footsteps of those who return."
        },
        {
          "lang": "en",
          "head": false,
          "text": "“Yes, I lived here…”"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Change is accepted, memories held."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "돌아가는 시간"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "개발 중 기자촌, 늦은 햇살과 계절, 그림자와 빛."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "은행나무, 소나무, 다시 찾는 발걸음."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "“그래, 여기 살고 있었지…” 변화를 받아들이면서도 기억은 놓지 않습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Like falling leaves, memory never truly fades."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "기억은 끝내 사라지지 않는다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A faint construction site against a sunset sky over the hills"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산 위 노을 하늘을 배경으로 희미한 건설 현장"
        }
      ]
    },
