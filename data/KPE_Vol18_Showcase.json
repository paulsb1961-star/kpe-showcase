      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Seonyudo Park."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "선유도를 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Timeless Flow"
        },
        {
          "lang": "en",
          "head": false,
          "text": "On an island reborn, old walls hold new breath."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Children run, lovers whisper, elders walk in calm steps."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Nothing was erased—nature entered what once stood still."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Beginning, present, depth, together."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Moments overlap like water purified yet still flowing."
        },
        {
          "lang": "en",
          "head": false,
          "text": "When the garden remembers you, your time remains."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "흐르는 시간"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "옛 구조물 위로 자연이 스며든 자리."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "아이의 웃음, 연인의 속삭임, 노부부의 느린 걸음."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "허물지 않고 되살린 공간에서 삶의 순간들이 겹쳐집니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "시작과 현재, 깊이와 함께."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "정화된 물이 흐르듯 삶도 흘러갑니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "정원이 당신을 기억하면 당신의 시간도 그곳에 남습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "All the seasons of life gather here in stillness."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "인생의 모든 계절이 이곳에 모인다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Green woods and the Han River, a boat on the water"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "초록빛 나무 숲과 한강, 물 위의 배"
        }
      ]
    },
