      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Namsan Park."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "남산공원을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Holding Hands"
        },
        {
          "lang": "en",
          "head": false,
          "text": "A child leaves her mother’s hand and walks unknown time."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Decades later, the mother appears like mist in a dream."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Time flows fast, irreversible."
        },
        {
          "lang": "en",
          "head": false,
          "text": "The hand beside you must be held warmly, here and now."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "손을 잡다"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "손을 놓지 않던 아이는 세상으로 나갑니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "중년이 된 어느 날, 희미한 엄마의 모습이 꿈에 스칩니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "시간은 빠르고 되돌릴 수 없습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "지금 옆에 있는 사람의 손을 더 따뜻하게 잡아야 합니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Before time slips away, I reach once more for my mother’s hand."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "시간이 흐르기 전에 엄마의 손을 다시 잡는다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "The hazy city below Namsan seen over a railing"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "난간 너머로 본, 남산 아래 안개 낀 도시"
        }
      ]
    },
