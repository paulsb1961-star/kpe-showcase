      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Deoksugung Palace."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "덕수궁을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Seasonal Faces"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Seasons turn across the palace pond."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Spring blossoms, autumn leaves, faces that come and go."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Beneath deepening shade, footsteps blend into centuries."
        },
        {
          "lang": "en",
          "head": false,
          "text": "“Now, yet not now; then, yet not then.”"
        },
        {
          "lang": "en",
          "head": false,
          "text": "An old man’s back, a child holding a hand—ordinary gestures where time quietly repeats itself."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "계절의 얼굴"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "연못 너머로 봄과 가을이 번갈아 옵니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "꽃이 피고 단풍이 지는 사이, 사람들이 스며듭니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "깊어지는 그늘 아래 발걸음은 오백 년의 시간에 겹쳐집니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "“지금이면서 지금이 아니고, 그때이면서도 그때가 아닌.”"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "노인의 뒷모습, 손을 잡은 아이."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "평범한 장면 속에서 시간은 조용히 반복됩니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Ordinary yet singular faces pass quietly through history."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "평범하지만 특별한 얼굴들이 역사 위를 지난다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "People at outdoor café tables beside the palace grounds"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "궁궐 곁 야외 카페 테이블의 사람들"
        }
      ]
    },
