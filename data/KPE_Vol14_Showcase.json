      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Samhwasa Temple."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "삼화사를 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Silent Traces"
        },
        {
          "lang": "en",
          "head": false,
          "text": "A small hermitage, silent for decades."
        },
        {
          "lang": "en",
          "head": false,
          "text": "The monk has gone, yet absence is not empty."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A well, an empty bowl, a vacant chair—forms that remember what once filled them."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Leaves gather in the courtyard."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Chanting fades."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Stillness deepens."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Vanished, yet not gone."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Emptied, yet full."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "고요한 흔적"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "작은 암자에 침묵이 남았습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "선승은 떠났지만 절집은 비어 있지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "우물과 빈 그릇, 비워진 의자는 한때 담고 있던 시간을 기억합니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "마당에는 낙엽이 구르고 독경 소리는 사라졌지만, 고요는 더 깊어집니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "사라진 듯, 그러나 사라지지 않은 자리."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Silence gently fills the emptiness left behind."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "비워진 자리, 고요로 충만해진다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A mossy stone retaining wall in close-up"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이끼 낀 축대 돌담의 근접"
        }
      ]
    },
