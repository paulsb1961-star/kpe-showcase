      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Changgyeonggung Palace."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "창경궁을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Autumn Pond"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Visitors experience time, not landscape."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Afternoon light through leaves becomes memory, life."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Falling leaves, ripples, passing footsteps."
        },
        {
          "lang": "en",
          "head": false,
          "text": "“Now, yet not now.”"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Autumn figures, flowing colors, moving people, sky and pond."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "가을 연못"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "창경궁 춘당지에서 사람들은 풍경이 아닌 시간을 마주합니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "오후 햇살이 잎새와 한복 위에서 기억과 삶이 되어 흐릅니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "단풍 여인, 색의 흐름, 사람, 연못."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "“지금이면서 지금이 아닌” 시간을 조용히 만납니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Even our footsteps, in time, become memory."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "우리의 발걸음도 결국 기억이 된다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Red maple leaves over the golden autumn reflections in the palace pond"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "궁궐 연못의 금빛 가을 반영 위로 드리운 붉은 단풍잎"
        }
      ]
