      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Hanok Village."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "한옥마을을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Village in Snow"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Snow falls over the village at the foot of the mountain."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Roofs whiten, paths soften, and silence gathers."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Now, yet not now; then, yet not then—the first snowfall opens a threshold of time."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Snowflakes, branches, tiled roofs."
        },
        {
          "lang": "en",
          "head": false,
          "text": "What seems to vanish remains in stillness."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a landscape to observe, but a path to walk—a poem shaped by winter."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "눈 내린 마을"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산 아래 마을에 눈이 내립니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "지붕은 희어지고, 골목은 부드러워지며, 고요가 내려앉습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "지금이면서도 지금이 아니고, 그때이면서도 그때가 아닌 순간."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "첫눈은 시간의 경계를 엽니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "눈송이, 가지, 기와지붕."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "사라진 듯한 장면은 고요 속에 남아 있습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이것은 바라보는 풍경이 아니라 걷는 길, 겨울이 빚은 한 편의 시입니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Along snow-covered paths, forgotten eras quietly remain."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "눈 덮인 길, 사라지지 않고 고요히 남은 시간."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Snow-laden pines on a hillside against a clear winter sky"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "맑은 겨울 하늘 아래 눈 얹힌 산비탈의 소나무들"
        }
      ]
    },
