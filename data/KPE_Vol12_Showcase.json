      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Temple Path · Neighborhood Park."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "절길과 공원길을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Shifting Time"
        },
        {
          "lang": "en",
          "head": false,
          "text": "From wide sight to a narrow gap—the shift reveals what had long been unseen."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Near and far dissolve into one horizon."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Fruits of unnoticed days quietly appear."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Above ground, slow footsteps wander; below, trains flash like light."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Gap, fruit, library, forest path."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Time moves in both slowness and speed."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "시선의 전환"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "넓게 보다가 좁은 틈으로 바라볼 때, 숨겨졌던 것들이 드러납니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "가까움과 멂이 하나로 이어지고, 지나온 시간의 열매가 비로소 보입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "공원 위로는 느린 걸음이 오가고, 그 아래로는 빛처럼 기차가 스쳐 갑니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "틈새, 열매, 도서관, 오솔길."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "시간은 느림과 빠름을 함께 품습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Through the narrowest gap, distance and nearness become one."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "좁은 틈, 가까움과 멂이 하나가 된다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A metal bar and dried grasses seen through a green net fence"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "초록 그물망 너머로 보이는 철 막대와 마른 풀"
        }
      ]
