      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Sangnim Village & Pokpodong."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "상림마을과 폭포동을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Life & Death"
        },
        {
          "lang": "en",
          "head": false,
          "text": "The Living and the Dead Sangnim Village · Pokpodong"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Morning light touches the valley."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Water moves over stone, breath lingers among trees."
        },
        {
          "lang": "en",
          "head": false,
          "text": "From village paths to quiet resting hills, life and death share one landscape."
        },
        {
          "lang": "en",
          "head": false,
          "text": "We pass through, yet leave traces behind."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Life, death, sunlight, flow."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Time moves gently—like water shaping stone."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "생사"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산 자와 죽은 자, 상림마을 · 폭포동"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "아침 빛이 계곡을 적십니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "물은 바위를 타고 흐르고 숨결은 나무 사이에 머뭅니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "마을 길에서 잠든 언덕에 이르기까지, 삶과 죽음은 하나의 풍경 안에 놓입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "우리는 지나가는 존재이면서도 흔적을 남깁니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "생과 사, 햇살과 흐름."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "시간은 물을 닮아 모든 것을 다듬어 갑니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Even in passing, we leave an indelible trace behind."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "산 자와 죽은 자의 길, 우리는 지나며 머문다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A wooden insect hotel standing among dry winter reeds"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "마른 겨울 갈대 사이에 선 나무 곤충호텔"
        }
      ]
