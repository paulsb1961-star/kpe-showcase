      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Uireung Royal Tomb."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "의릉을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Silent Dialogue"
        },
        {
          "lang": "en",
          "head": false,
          "text": "King Gyeongjong, orphaned at fourteen, and Lady Jang Hui-bin, poisoned early—rest apart for 300 years."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Through sunset light, the tombs converse across time."
        },
        {
          "lang": "en",
          "head": false,
          "text": "In the city’s midst, stone monuments and apartments meet, and longing persists silently."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "고요한 대화"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "열네 살에 고아가 된 경종, 사약을 받은 어머니 장희빈."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "서로 다른 무덤 속 300년의 고요."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "석양 속 아이와 어미는 시간을 넘어 대화를 이어갑니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "도심 속 왕릉과 아파트, 석물 사이로 그리움은 여전히 남아 있습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Across three hundred years, mother and son meet again."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "300년을 건너 다시 만난 모자."
        },
        {
          "lang": "en",
          "head": false,
          "text": "The royal tomb silhouetted dark against a setting sun"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "해가 지는 하늘을 배경으로 검은 색의 왕릉"
        }
      ]
    },
