      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Gijachon Village."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "기자촌을 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Snowy Path"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Below the hill, a snow-covered path remains where a village once stood."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Houses erased, names faded, yet footprints linger beneath white silence."
        },
        {
          "lang": "en",
          "head": false,
          "text": "“On a snowy path I see what has passed.”"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Hill, path, trace, stillness."
        },
        {
          "lang": "en",
          "head": false,
          "text": "At the edge of disappearance, existence speaks softly."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Now, yet not now; then, yet not then."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Everything flows, yet nothing wholly vanishes."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "눈길"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "언덕 아래 눈 덮인 길이 남아 있습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "한때 마을이 있던 자리."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "집은 사라지고 이름은 흐려졌지만, 흔적은 하얀 고요 아래 머뭅니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "“눈길 위에서 지나온 시간을 봅니다.”"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "언덕, 길, 흔적, 적막."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "사라짐의 경계에서 존재는 낮게 숨 쉽니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "지금이면서도 지금이 아니고, 그때이면서도 그때가 아닌 시간."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "모든 것은 흐르지만 아무것도 완전히 사라지지 않습니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Where chroniclers once dwelt, the traces of time softly return."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "기록의 자리, 시간이 돌아온다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "A rock capped with a mound of snow, footprints pressed into the snow"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "눈 더미를 이고 있는 바위, 눈 위에 새겨진 발자국"
        }
      ]
    },
