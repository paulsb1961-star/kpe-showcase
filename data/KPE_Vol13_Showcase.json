      "transcript": [
        {
          "lang": "en",
          "head": false,
          "text": "A quiet photographic meditation set in Jingwansa Temple."
        },
        {
          "lang": "en",
          "head": false,
          "text": "This is not a guide to Korea."
        },
        {
          "lang": "en",
          "head": false,
          "text": "It is a way of feeling it."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "진관사를 배경으로 한 조용한 사진 명상입니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이 책은 설명하지 않습니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "대신 한국의 시간과 풍경 속에 잠시 머물도록 초대합니다."
        },
        {
          "lang": "en",
          "head": true,
          "text": "Mind’s Reflection"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Spring blossoms glow, lanterns sway in bright air."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Yet within beauty, the mind stirs—wanting more, reacting, wandering."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Reflections tremble in temple windows."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Are we seeing the world, or our own mind?"
        },
        {
          "lang": "en",
          "head": false,
          "text": "Lantern, reflection, humility."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Beyond the gate, the journey is inward."
        },
        {
          "lang": "ko",
          "head": true,
          "text": "마음의 반영"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "봄꽃과 연등이 밝게 흔들립니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "그 사이 마음은 탐하고, 성내고, 흔들립니다."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "창문에 비친 연등의 반영."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "우리는 세상을 보는 걸까요, 아니면 마음을 보는 걸까요."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "연등, 반영, 하심."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "담장을 지나 마음은 안으로 향합니다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "When lantern light touches the window, we meet the landscape of our own hearts."
        },
        {
          "lang": "ko",
          "head": false,
          "text": "연등의 빛 속에서, 우리는 세상이 아닌 마음을 본다."
        },
        {
          "lang": "en",
          "head": false,
          "text": "Yellow cornus flowers blooming on a bare branch in early spring"
        },
        {
          "lang": "ko",
          "head": false,
          "text": "이른 봄, 앙상한 가지에 핀 노란 산수유 꽃"
        }
      ]
    },
